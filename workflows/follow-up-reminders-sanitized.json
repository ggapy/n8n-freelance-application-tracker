      "id": "3f4bc729-7b09-4a4a-9499-7db9c3c04648",
      "name": "Get row(s) in sheet",
      "notes": "After importing, select your spreadsheet and its 'Applications' tab.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\nconst FOLLOW_UP_DAYS = 7;\n\nconst parts = new Intl.DateTimeFormat('en-GB', {\n  timeZone: 'America/Asuncion',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).formatToParts(new Date());\n\nconst dateParts = Object.fromEntries(\n  parts.map(p => [p.type, p.value])\n);\n\nconst today = `${dateParts.year}-${dateParts.month}-${dateParts.day}`;\n\nfunction parseDate(value) {\n  const s = String(value ?? '').trim();\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(s)) return null;\n  const ms = Date.parse(s + 'T00:00:00Z');\n  if (!Number.isFinite(ms)) return null;\n  return new Date(ms).toISOString().slice(0, 10) === s\n    ? ms : null;\n}\n\nconst todayMs = parseDate(today);\nconst results = [];\n\nfor (const item of rows) {\n  const row = item.json;\n  const status = String(row['Status'] ?? '').trim().toLowerCase();\n\n  if (!['applied', 'interview'].includes(status)) continue;\n\n  const lastContact = parseDate(row['Last Contact']);\n  if (lastContact === null) continue;\n\n  const days = Math.floor((todayMs - lastContact) / 86400000);\n  if (days < FOLLOW_UP_DAYS) continue;\n\n  const reminderText = String(row['Reminder'] ?? '').trim();\n  const lastReminder = parseDate(reminderText);\n\n  // Skip records with an unrecognized nonempty reminder value.\n  if (reminderText && lastReminder === null) continue;\n\n  // Don't repeat a reminder for the same contact.\n  if (lastReminder !== null && lastReminder >= lastContact) continue;\n\n  results.push({\n    json: {\n      ...row,\n      daysSinceContact: days,\n      reminderDate: today\n    }\n  });\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        -16
      ],
