        -112
      ],
      "id": "b3f7a7ca-302e-4072-af78-b669f98fcdaf",
      "name": "Classify Email"
    },
    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all()\n  .map(item => item.json)\n  .filter(row =>\n    row &&\n    Object.keys(row).length > 0 &&\n    String(row['Application ID'] || '').trim()\n  );\n\nconst gmail = $('Gmail Trigger').first().json;\nconst prepared = $('Edit Fields').first().json;\n\nconst subject = String(gmail.Subject || '');\nconst snippet = String(gmail.snippet || '');\nconst emailText = `${subject} ${snippet}`;\n\nfunction normalize(value) {\n  return String(value || '')\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction words(value) {\n  return normalize(value)\n    .split(' ')\n    .filter(word => word.length >= 4);\n}\n\nconst normalizedText = normalize(emailText);\nconst emailWords = new Set(words(emailText));\n\nfunction hasExactPhrase(value) {\n  const phrase = normalize(value);\n  return phrase &&\n    (` ${normalizedText} `).includes(` ${phrase} `);\n}\n\nconst scored = rows.map(row => {\n  const applicationId =\n    String(row['Application ID'] || '').trim();\n\n  const company = row['Client / Company'];\n  const role = row['Project / Role'];\n\n  let score = 0;\n  const reasons = [];\n\n  if (\n  prepared.applicationId &&\n  applicationId.toUpperCase() ===\n    String(prepared.applicationId).trim().toUpperCase()\n) {\n  score += 100;\n  reasons.push('application-id');\n}\n\n  const contactEmail = String(\n  row['Contact Info'] || ''\n).trim().toLowerCase();\n\nconst senderEmail = String(\n  prepared.senderEmail || ''\n).trim().toLowerCase();\n\nif (\n  senderEmail &&\n  contactEmail &&\n  senderEmail === contactEmail\n) {\n  score += 20;\n  reasons.push('sender-email');\n}\n  \n\n  if (hasExactPhrase(company)) {\n    score += 5;\n    reasons.push('company');\n  }\n\n  const roleWords = [...new Set(words(role))];\n\n  const matchedRoleWords = roleWords.filter(\n    word => emailWords.has(word)\n  );\n\n  score += matchedRoleWords.length;\n\n  if (matchedRoleWords.length) {\n    reasons.push(\n      `role:${matchedRoleWords.join(',')}`\n    );\n  }\n\n  return { row, score, reasons };\n});\n\nscored.sort((a, b) => b.score - a.score);\n\nconst best = scored[0];\nconst second = scored[1];\n\nlet safeMatch = false;\nlet matchReasons = '';\n\nif (!best) {\n  matchReasons = 'No candidate application found.';\n} else {\n  const exactId = best.reasons.includes('application-id');\n  const uniqueExactId = exactId &&\n    !scored.slice(1).some(candidate =>\n      candidate.reasons.includes('application-id')\n    );\n\n  const clearLead =\n    !second || best.score >= second.score + 2;\n\n  safeMatch =\n    uniqueExactId ||\n    (best.score >= 5 && clearLead);\n\n  matchReasons = best.reasons.join(', ');\n\n  if (!safeMatch) {\n    matchReasons =\n      `Manual review required: ${rows.length} candidate(s), ` +\n      `best score ${best.score}.`;\n  }\n}\n\nreturn [{\n  json: {\n    ...(best ? best.row : {}),\n    applicationId: prepared.applicationId || '',\n    senderEmail: prepared.senderEmail || '',\n    matchScore: best ? best.score : 0,\n    matchReasons,\n    candidateCount: rows.length,\n    safeMatch\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
