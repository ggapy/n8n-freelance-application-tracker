      "name": "Update row in sheet",
      "notes": "After importing, select your spreadsheet and its 'Applications' tab.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "0ffb28bd-7583-478f-9f6f-96c999d4739d",
              "name": "detectedStatus",
              "value": "={{\n(() => {\n  const gmail = $('Gmail Trigger').first().json;\n\n  const subject = String(\n    gmail.Subject ||\n    gmail.subject ||\n    ''\n  );\n\n  const snippet = String(\n    gmail.snippet ||\n    gmail.Snippet ||\n    ''\n  );\n\n  const text = `${subject} ${snippet}`.toLowerCase();\n\n  // --------------------------------\n  // 1. Interview / meeting / call\n  // --------------------------------\n  if (\n    text.includes('interview') ||\n    text.includes('schedule a call') ||\n    text.includes('schedule a meeting') ||\n    text.includes('invite you to a call') ||\n    text.includes('invite you to an interview') ||\n    text.includes('available to discuss') ||\n    text.includes('availability for a call') ||\n    text.includes('availability for an interview')\n  ) {\n    return 'Interview';\n  }\n\n  // --------------------------------\n  // 2. Offer\n  // --------------------------------\n  if (\n    text.includes('offer letter') ||\n    text.includes('job offer') ||\n    text.includes('offer you') ||\n    text.includes('pleased to offer') ||\n    text.includes('would like to offer')\n  ) {\n    return 'Offer';\n  }\n\n  // --------------------------------\n  // 3. Rejection\n  // --------------------------------\n  if (\n    text.includes('unfortunately') ||\n    text.includes('not moving forward') ||\n    text.includes('not proceed') ||\n    text.includes('other candidates') ||\n    text.includes('position has been filled') ||\n    text.includes('decided not to proceed') ||\n    text.includes('will not be moving forward')\n  ) {\n    return 'Rejected';\n  }\n\n  // --------------------------------\n  // 4. Meaningful reply\n  // --------------------------------\n  if (\n    text.includes('interested in your') ||\n    text.includes('interested in discussing') ||\n    text.includes('would like to discuss') ||\n    text.includes('would like to know more') ||\n    text.includes('please send') ||\n    text.includes('could you send') ||\n    text.includes('can you send') ||\n    text.includes('please provide') ||\n    text.includes('could you provide') ||\n    text.includes('can you provide') ||\n    text.includes('have some freelance work') ||\n    text.includes('project opportunity') ||\n    text.includes('next steps')\n  ) {\n    return 'Replied';\n  }\n\n  // --------------------------------\n  // 5. Everything else\n  // --------------------------------\n  return 'Other';\n})()\n}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
