              "value": "={{ (() => {\n  const email = $('Gmail Trigger').first().json;\n  const text = `${email.subject || ''} ${email.snippet || ''}`.toLowerCase();\n\n  if (/\\b(reject(?:ed|ion)?|regret|not moving forward|unfortunately|unsuccessful)\\b/.test(text)) {\n    return 'Rejected';\n  }\n  if (/\\b(offer|accepted|hired)\\b/.test(text)) {\n    return 'Accepted';\n  }\n  if (/\\b(interview|schedule a call)\\b/.test(text)) {\n    return 'Interview';\n  }\n  return 'Needs Review';\n})() }}",
              "type": "string"
            }
          ]
        },
